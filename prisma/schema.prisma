// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum Role {
  ADMIN
  USER
}

enum TenantStatus {
  ACTIVE
  DISABLED
}

/// Control-plane record: one row per company using the system, pointing at
/// that company's own isolated database. Lives only in the control database
/// (see src/lib/prisma.ts) — tenant databases carry this table too (same
/// shared schema/migrations) but never populate it.
model Tenant {
  id          String       @id @default(uuid())
  code        String       @unique // 4-digit login code, e.g. "0000"
  name        String
  dbUrl       String
  dbAuthToken String?
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

model FormLabel {
  key         String   @id
  label       String?
  description String?
  frequency   String?
  updatedAt   DateTime @updatedAt
}

model Company {
  id           String   @id @default(uuid())
  name         String   @unique
  address      String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rosters Roster[]
}

model Roster {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Driver {
  id               String       @id @default(uuid())
  pfl              String?
  clientId         String? // "Client ID" from roster-style imports (distinct from driversLicense)
  company          String? // organization/client the driver is categorized under
  roster           String? // site/roster code within a company, e.g. "PREK"
  lastName         String
  firstName        String
  phone            String?
  email            String?
  position         String?
  driversLicense   String?
  ssn              String? // stored masked, e.g. ***-**-1234
  dob              DateTime?
  licenseClass     String?
  endorsements     String?
  restrictions     String?
  status           DriverStatus @default(ACTIVE)
  updateResult     String?
  note             String? // free-text remark, e.g. from a roster's NOTE column
  medicalCondition String?
  bpFollowUp       String?
  diabeticFollowUp String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  complianceForm   ComplianceForm?
  customFormValues CustomFormValue[]
  documents        DriverDocument[]

  @@index([lastName, firstName])
  @@index([status])
  @@index([company, roster])
}

model ComplianceForm {
  id       String @id @default(uuid())
  driverId String @unique
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  pptXray    DateTime? // Passport / X-Ray
  mcsa5876   DateTime? // Medical Examiner Certificate
  ds703      DateTime? // Medical Examination Report
  ds704      DateTime? // Physical Fitness Certification
  licenseExp DateTime? // Driver's License Expiration
  ds870      DateTime? // Application / Driver Profile
  ds872      DateTime? // Annual Review of Driving Record
  ds873      DateTime? // Biennial Behind-the-Wheel
  ds875      DateTime? // Biennial Written Exam
  ds875y     DateTime? // Biennial Written Exam Y

  // Extra field present in source data, not part of the core 9 but tracked for completeness
  annualDefensiveDrivingTest DateTime?

  updatedAt DateTime @updatedAt
}

model CustomForm {
  key         String   @id
  label       String
  description String
  frequency   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values CustomFormValue[]
}

model CustomFormValue {
  id        String    @id @default(uuid())
  driverId  String
  formKey   String
  date      DateTime?
  updatedAt DateTime  @updatedAt

  driver     Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  customForm CustomForm @relation(fields: [formKey], references: [key], onDelete: Cascade)

  @@unique([driverId, formKey])
}

model DriverDocument {
  id          String   @id @default(uuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  label       String
  filename    String
  pathname    String   @unique
  contentType String?
  size        Int
  uploadedAt  DateTime @default(now())
}
