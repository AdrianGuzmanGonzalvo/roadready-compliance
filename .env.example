# Used by `prisma migrate dev` (schema authoring) and by scripts that target
# one specific database, e.g. scripts/create-user.ts or
# scripts/register-existing-tenant.ts. Not read by the running app itself —
# see CONTROL_DATABASE_URL and the per-tenant Tenant.dbUrl rows below.
DATABASE_URL="file:./prisma/dev.db"

# Site access (see src/lib/auth.ts / src/proxy.ts). User accounts live in each
# tenant's own database (User model); create one with:
#   npx tsx scripts/create-user.ts <username> <password>
AUTH_SECRET="generate-a-long-random-string"

# --- Multi-tenancy ---
# Every company using the system has its own separate database. The control
# database below holds only the `Tenant` registry: 4-digit login code -> that
# company's dbUrl/dbAuthToken. The app resolves it on every login and looks
# up the session's tenant on every request (see src/lib/prisma.ts).
CONTROL_DATABASE_URL="file:./prisma/control.db"
# CONTROL_TURSO_AUTH_TOKEN="" # only needed if CONTROL_DATABASE_URL is libsql://

# Optional: lets scripts/create-tenant.ts provision a real Turso database for
# each new company automatically instead of a local SQLite file. Get an API
# token from the Turso dashboard/CLI; TURSO_ORG is your organization slug.
# TURSO_API_TOKEN=""
# TURSO_ORG=""
# TURSO_GROUP="default"

# --- Scheduled report emails ---
# Sent by src/app/api/cron/send-scheduled-reports, triggered once a day by the
# Vercel Cron defined in vercel.json. CRON_SECRET must match what Vercel sends
# as the Authorization header — generate any long random string.
CRON_SECRET="generate-a-long-random-string"
# Get a key at resend.com (free tier is plenty for this). Without it, the
# cron route no-ops with an error instead of crashing the app.
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend, or leave as the sandbox
# address below (only deliverable to your own Resend account email).
RESEND_FROM_EMAIL="RoadReady Compliance <onboarding@resend.dev>"
# Used to build the "View full report" link in scheduled emails.
APP_URL="https://roadready-compliance.vercel.app"

# --- Analytics (see analytics-plan.md / src/lib/analytics.ts) ---
# GA4 measurement id for the public marketing pages only. Unset = no GA4 at all.
# NEXT_PUBLIC_GA_ID="G-XXXXXXX"
# PostHog product analytics for all surfaces (see src/instrumentation-client.ts).
# The project key is public and write-only. Unset = PostHog is never loaded.
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# First-party collector for login + signed-in app events (one JSON POST per event,
# sent as text/plain). Unset = those events never leave the browser.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT="https://collector.example.com/events"
# "true" logs every event to the browser console in production too (always on in `next dev`).
# NEXT_PUBLIC_ANALYTICS_DEBUG="false"
